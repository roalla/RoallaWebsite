# Email (Resend) – consultation requests & contact form → sales@roalla.com
RESEND_API_KEY="re_..."

# Google Search Console site verification (optional)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION="your-google-verification-code"

# Bing Webmaster Tools verification (optional)
NEXT_PUBLIC_BING_SITE_VERIFICATION="your-bing-verification-code"

# Google Analytics 4 measurement ID (optional)
NEXT_PUBLIC_GA_MEASUREMENT_ID="G-XXXXXXXXXX"

# ── Roalla Internal Hub (register client at https://sso.roalla.com/guide.html) ──
AUTH_URL="https://sso.roalla.com"
AUTH_CLIENT_ID="roalla-hub"
APP_URL="https://www.roalla.com"
APP_NAME="Roalla Internal Hub"
LOCAL_DEV_URL="http://localhost:3000"

# Hub administrator — receives admin role on sign-in (comma-separated for multiple)
HUB_ADMIN_EMAIL="admin@roalla.com"

# Railway Postgres (required for customer tracker & playbooks)
DATABASE_URL="postgresql://user:pass@host:5432/roalla_hub"

# Notion embed URLs (optional — create databases in Notion, paste public/share URLs)
NEXT_PUBLIC_NOTION_PARTNERS_URL=""
NEXT_PUBLIC_NOTION_LESSONS_URL=""

# Optional: hub product email for notifications
# AUTH_MAIL_SECRET="ams_..."
